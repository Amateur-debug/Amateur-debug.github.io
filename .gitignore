# Deny by default. Allow only website sources and build configuration.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/Gemfile
!/Gemfile.lock
!/LICENSE
!/README.md
!/_config.yml
!/.github/
/.github/*
!/.github/workflows/
!/themes/
!/tools/

# Optional shared editor settings.
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json

# Keep local editor, system and generated files out of allowed directories.
.DS_Store
Thumbs.db
.idea/
__pycache__/
*.py[cod]
*~

.bundle/
vendor/
.jekyll-cache/
.jekyll-metadata
_site/
*.gem
node_modules/
package-lock.json
.build/
.content/
